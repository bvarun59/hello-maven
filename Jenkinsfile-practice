pipeline{
    agent any

    tools {
        maven 'maven'
        jdk 'jdk'
    }

    environment {
        IMAGE = "varundocker3/mavenapp:v1"
        winserverip = "192.168.0.8"
        Containername = "mavenapp"
    }

    stages{
        stage("clean"){
          steps{
             sh 'mvn clean'
          }  
        }
        stage("validate"){
           steps{
              sh 'mvn validate'
           }    
        }
        stage("compile"){
            steps{
              sh 'mvn compile'
            }
        }
        stage("test"){
            steps{
              sh 'mvn test'
            }
        }
        stage("package"){
            steps{
               sh 'mvn package'
                archiveArtifacts artifacts: 'target/*.jar', followSymlinks: true
            }
        }
        stage("login to dockerhub"){
            steps{
                withCredentials([usernamePassword(credentialsId: 'Dockerhub-Cred', passwordVariable: 'dhubpass', usernameVariable: 'dhubuser')]) {
                 sh 'echo $dhubpass | docker login -u $dhubuser --password-stdin'
                }    
            }            
        }
        stage("build image"){
            steps{
                sh 'docker build -t $IMAGE .' 
                sh 'docker push $IMAGE' 
            }
        }
        stage("deploy container"){
            steps{
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'ssh-cred-win', keyFileVariable: 'sshwin', usernameVariable: 'ssh-winuser'),
                    usernamePassword(credentialsId: 'Dockerhub-Cred', passwordVariable: 'dhubpass', usernameVariable: 'dhubuser')
                    ]) {

                sh """
                    ssh -i $sshwin -o StrictHostKeyChecking=no $ssh-winuser@$winserverip '
                        echo $dhubpass | docker login -u $dhubuser --password-stdin 
                        docker desktop start || true
                        docker pull $IMAGE
                        docker stop $Containername || true
                        docker rm $Containername || true
                        docker run -d -p 1515:8080 --name $Containername $IMAGE
                        '
                    """
                }
            }
        }

    }
}