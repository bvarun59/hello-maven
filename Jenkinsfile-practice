pipeline{
    agent any

    tools {
        maven 'maven'
        jdk 'jdk'
    }

    environment {
        IMAGE = "varundocker3/mavenapp:v1"
    }

    stages{
        stage("clean"){
          steps{
             sh 'mvn clean'
          }  
        }
        stage("validate"){
           steps{
              sh 'mvn validate'
           }    
        }
        stage("compile"){
            steps{
              sh 'mvn compile'
            }
        }
        stage("test"){
            steps{
              sh 'mvn test'
            }
        }
        stage("package"){
            steps{
               sh 'mvn package'
                archiveArtifacts artifacts: 'target/*.jar', followSymlinks: true
            }
        }
        stage("login to dockerhub"){
            steps{
                withCredentials([usernamePassword(credentialsId: 'Dockerhub-Cred', passwordVariable: 'dhubpass', usernameVariable: 'dhubuser')]) {
                 sh 'echo $dhubpass | docker login -u $dhubuser --password-stdin'
                }    
            }            
        }
        stage("build image"){
            steps{
                sh 'docker build -t $IMAGE .'  
            }
        }
        stage("deploy container"){
            steps{
                sh 'docker pull $IMAGE'
                sh 'docker run -d -p 1515:8080 --name mavenapp $IMAGE'
            }
        }

    }
}