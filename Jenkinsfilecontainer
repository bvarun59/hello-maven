pipeline{
    agent {
        docker {
            image 'maven:3.9.15-eclipse-temurin-26'
           // args '-v $HOME/.m2:/root/.m2'
        }
    }
    stages{
        stage("compile"){
            steps{
                sh 'mkdir -p $WORKSPACE/.m2/repository'
                sh 'mvn clean compile -Dmaven.repo.local=$WORKSPACE/.m2/repository'
            }
        }
        stage("package"){
            steps{
                sh 'mvn package -Dmaven.repo.local=$WORKSPACE/.m2/repository'
            }
        }
        stage("artifact"){
            steps{
                archiveArtifacts artifacts: 'target/*.jar', followSymlinks: true
            }
        }
    }
}