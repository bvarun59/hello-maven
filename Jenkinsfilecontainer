pipeline{
    agent {
        docker {
            image 'maven:3.9.15-eclipse-temurin-26'
        }
    }
    stages{
        stage("compile"){
            steps{
                sh 'mvn clean compile'
            }
        }
        stage("package"){
            steps{
                sh 'mvn package'
            }
        }
        stage("artifact"){
            steps{
                archiveArtifacts artifacts: 'target/*.jar', followSymlinks: true
            }
        }
    }
}